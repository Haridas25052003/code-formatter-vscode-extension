{
  "name": "code-formatter",
  "displayName": "Code Formatter",
  "description": "Formats code using AST",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:code-formatter.formatCode"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-formatter.formatCode",
        "title": "Format My Code"
      }
    ],
    "configuration": {
      "title": "Code Formatter",
      "properties": {
        "codeFormatter.tabSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for indentation"
        }
      }
    }
  },
  "scripts": {},
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0"
  }
}
